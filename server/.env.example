PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/transact3
JWT_SECRET=replace-with-a-long-random-secret

# Razorpay test-mode credentials. The key ID may be exposed to the client;
# never expose or commit the key secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional first-run account provisioning. Passwords stay in this local env file.
BOOTSTRAP_USER_1_NAME=Aayush
BOOTSTRAP_USER_1_EMAIL=aayush@gmail.com
BOOTSTRAP_USER_1_PASSWORD=
BOOTSTRAP_USER_2_NAME=Anirudh
BOOTSTRAP_USER_2_EMAIL=anirudh@gmail.com
BOOTSTRAP_USER_2_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# 1. Live Exchange Rates Provider (ExchangeRate-API)
# Obtain a free key from: https://www.exchangerate-api.com/
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# 2. Cross-Border Rail Pricing Engine Mode:
# Options: HYBRID (default - uses live API when available, falls back to institutional engine)
#          CALIBRATED_ENGINE (pure deterministic institutional formula)
#          LIVE_API (strictly calls live external quote providers)
RAIL_PRICING_MODE=HYBRID

# 3. Optional External Payment Rail Quote APIs:
# Wise Platform API (Free Sandbox / Production key from https://wise.com/us/business/platform):
WISE_API_KEY=your_wise_api_token
# Currencycloud API (From https://www.currencycloud.com):
CURRENCYCLOUD_API_KEY=your_currencycloud_key
# Stripe API Key (For Card Payout / Visa Direct quote benchmarking):
STRIPE_API_KEY=your_stripe_secret_key

# 4. Optional Python Intelligence Microservice (FastAPI Port 8000)
FASTAPI_URL=http://127.0.0.1:8000
